{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "in_scope", "excluded", "source_preferences"],
  "properties": {
    "questions": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } },
    "in_scope": { "type": "string" },
    "excluded": { "type": "string" },
    "source_preferences": { "type": "string" }
  }
}
